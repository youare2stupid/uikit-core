  "markup": "<ui-accordion single>\n  <div data-ui-role=\"item\">\n    <button data-ui-role=\"trigger\">Header 1</button>\n    <div data-ui-role=\"content\">Content 1</div>\n  </div>\n  <div data-ui-role=\"item\">\n    <button data-ui-role=\"trigger\">Header 2</button>\n    <div data-ui-role=\"content\">Content 2</div>\n  </div>\n</ui-accordion>",
